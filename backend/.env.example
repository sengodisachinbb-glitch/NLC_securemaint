# NLC-SecureMaint Backend Environment Configuration
# Copy this file to .env and configure your values

PORT=5000
JWT_SECRET=your_super_strong_random_secret_key_here_min_64_chars
DEMO_MODE=false
FRONTEND_URL=http://localhost:3000

# Rate Limiting configuration (defaults: LOGIN_RATE_LIMIT_MAX=10, API_RATE_LIMIT_MAX=200)
# NOTE: These rate limits should only be raised for local security scanning (e.g., OWASP ZAP)
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=200

